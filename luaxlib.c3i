module lua54::lua;

struct LuaLReg {
  ZString name;
  LuaCFunction func;
}

const NUMSIZES	= LuaInteger.sizeof*16 + LuaNumber.sizeof;

extern fn void checkversion(LuaState* l, LuaNumber ver = VERSION_NUM, isz sz = NUMSIZES) @cname("luaL_checkversion_");

extern fn int		l_getmetafield		(LuaState* l, int arg, ZString e) 				@cname("luaL_getmetafield");
extern fn int 		l_callmeta			(LuaState* l, int arg, ZString e) 				@cname("luaL_callmeta");
extern fn ZString 	l_tolstring			(LuaState* l, int idx, isz* e) 					@cname("luaL_tolstring");
extern fn int 		l_argerror			(LuaState* l, int arg, ZString e) 				@cname("luaL_argerror");
extern fn int 		l_typeerror			(LuaState* l, int arg, ZString tname) 			@cname("luaL_typeerror");
extern fn ZString 	l_checklstring		(LuaState* l, int arg, isz* e) 					@cname("luaL_checklstring");
extern fn ZString 	l_optlstring		(LuaState* l, int arg, ZString def, isz* len) 	@cname("luaL_optlstring");
extern fn LuaNumber l_checknumber		(LuaState* l, int arg) 							@cname("luaL_checknumber");
extern fn LuaNumber l_optnumber			(LuaState* l, int arg, LuaNumber def) 			@cname("luaL_optnumber");

extern fn LuaInteger l_checkinteger	(LuaState* l, int arg, ZString e)	@cname("luaL_checkinteger");
extern fn LuaInteger l_optinteger	(LuaState* l, int arg, ZString e) 	@cname("luaL_optinteger");

extern fn void 	l_checkstack	(LuaState* l, int sz, ZString msg) 		@cname("luaL_checkstack");
extern fn void 	l_checktype		(LuaState* l, int arg, int t) 			@cname("luaL_checktype");
extern fn void 	l_checkany		(LuaState* l, int arg) 					@cname("luaL_checkany");

extern fn int 	l_newmetatable	(LuaState* l, ZString tname) 			@cname("luaL_newmetatable");
extern fn void 	l_setmetatable	(LuaState* l, ZString tname) 			@cname("luaL_setmetatable");
extern fn void* l_testudata		(LuaState* l, int ud, ZString tname) 	@cname("luaL_testudata");
extern fn void* l_checkudata	(LuaState* l, int ud, ZString tname) 	@cname("luaL_checkudata");

extern fn void 	l_where(LuaState* l, int lvl) 		@cname("luaL_where");
extern fn int 	l_error(LuaState* l, ZString fmt) 	@cname("luaL_error");

extern fn int 	l_checkoption(LuaState* l, int arg, ZString def, ZString* lst) @cname("luaL_checkoption");

extern fn int 	l_fileresult(LuaState* l, int stat, ZString fname) 	@cname("luaL_fileresult");
extern fn int 	l_execresult(LuaState* l, int stat)					@cname("luaL_execresult");

/* predefined references */
const NOREF = 	-1;
const REFNIL = 	-2;

extern fn int 	l_ref	(LuaState* l, int t) 			@cname("luaL_ref");
extern fn int 	l_unref	(LuaState* l, int t, int ref) 	@cname("luaL_unref");

extern fn int 	l_loadfilex	(LuaState* l, ZString filename, ZString mode) @cname("luaL_loadfilex");
macro int 		l_loadfile	(LuaState* l, ZString f) { return lua::l_loadfilex(l, f, null); }


extern fn int l_loadstring	(LuaState* l, ZString s) @cname("luaL_loadstring");
extern fn int l_loadbufferx	(LuaState* l, ZString buff, usz sz, ZString name, ZString mode) @cname("luaL_loadbufferx");

extern fn LuaState* l_newstate() @cname("luaL_newstate");

extern fn LuaInteger l_len(LuaState* l, int idx) @cname("luaL_len");

extern fn void l_addgsub(LuaState* l, LuaLBuffer* b, ZString s, ZString p, ZString r) @cname("luaL_addgsub");
extern fn ZString l_gsub(LuaState* l, ZString s, ZString p, ZString r) @cname("luaL_gsub");

extern fn void l_setfuncs	(LuaState* l, LuaLReg* funcs, int nup) @cname("luaL_setfuncs");
extern fn int l_getsubtable	(LuaState* l, int idx, ZString fname) @cname("luaL_getsubtable");
extern fn void l_traceback	(LuaState* l, LuaState*  l1, ZString msg, int level) @cname("luaL_traceback");
extern fn void l_requiref	(LuaState* l, ZString modname, LuaCFunction openf, int glb) @cname("luaL_requiref");


/*
** ===============================================================
** some useful macros
** ===============================================================
*/

macro void l_newlibtable(LuaState* l, LuaLReg* table) { lua::createtable(l, 0, $sizeof(table)/$sizeof(table[0]) - 1); }
macro void l_newlib(LuaState* l, LuaLReg* lib) { lua::checkversion(l); lua::l_newlibtable(l, lib); lua::l_setfuncs(l, lib, 0);}
macro void @l_argcheck(LuaState* l, #cond, int arg, ZString extramsg) { #cond || lua::l_argerror(l, arg, extramsg); }
macro void @l_argexpected(LuaState* l, #cond, int arg, ZString tname) { #cond || lua::l_typeerror(l, arg, tname); }
macro void l_checkstring(LuaState* l, n) { return lua::l_checklstring(l, n, null); }
macro void l_optstring(LuaState* l, n, d) { return lua::l_optlstring(l, n, d, null); }

macro l_typename(LuaState* l, i) { return lua::typename(lua::type(l, i)); }
macro l_dofile(LuaState* l, func) { return lua::l_loadfile(l, func) || lua::pcall(l, 0, MULTRET, 0); }
macro int l_dostring(LuaState* l, s) { return (int)(lua::l_loadstring(l, s) || lua::pcall(l, 0, MULTRET, 0)); }
macro l_getmetatable(LuaState* l, n) { return lua::getfield(l, REGISTRYINDEX, n); }

macro l_opt(LuaState* l,f,n,d) { return lua::isnoneornil(l, n) ? d : f(l, n);}
macro int l_loadbuffer(LuaState* l, ZString s, usz sz, ZString name) { return l_loadbufferx(l, s, sz, name, null); }
macro l_pushfail(LuaState* l) { return lua::pushnil(l);}

/*
** {======================================================
** Generic Buffer manipulation
** =======================================================
*/

struct LuaLBuffer {
	char* b;
	usz size;
	usz n;
	LuaState* lua;
	union {
		usz[16] init; // ensure maximum alignment for buffer
		char[BUFFERSIZE] b_init;  // initial buffer
	}
}

macro usz l_bufflen(LuaLBuffer* bf) { return bf.n; }
macro char* l_buffaddr(LuaLBuffer* bf) { return bf.b; }

macro void l_addchar(LuaLBuffer* b, char c) { 
 	if (b.n >= b.size) l_prepbuffsize(b, 1); 
 	b.b[b.n++] = c; 
}

macro void l_addsize(LuaLBuffer* b, usz s) { b.n += s; }

macro void l_buffsub(LuaLBuffer* b, usz s) { b.n -= s; }

extern fn void 	l_buffinit			(LuaState* l, LuaLBuffer* b) 		 @cname("luaL_buffinit");
extern fn char* l_prepbuffsize		(LuaLBuffer* b, usz sz) 			 @cname("luaL_prepbuffsize");
extern fn void 	l_addlstring		(LuaLBuffer* b, ZString s, usz l) 	 @cname("luaL_addlstring");
extern fn void 	l_addstring			(LuaLBuffer* b, ZString s) 			 @cname("luaL_addstring");
extern fn void 	l_addvalue			(LuaLBuffer* b) 					 @cname("luaL_addvalue");
extern fn void 	l_pushresult		(LuaLBuffer* b) 					 @cname("luaL_pushresult");
extern fn void 	l_pushresultsize	(LuaLBuffer* b, usz sz) 			 @cname("luaL_pushresultsize");
extern fn char* l_buffinitsize		(LuaState* l, LuaLBuffer* b, usz sz) @cname("luaL_buffinitsize");

macro char* l_prepbuffer(LuaLBuffer* b) { return b.l_prepbuffsize(BUFFERSIZE); }

/* }====================================================== */

/*
** {======================================================
** File handles for IO library
** =======================================================
*/

/*
** A file handle is a userdata with metatable 'LUA_FILEHANDLE' and
** initial structure 'luaL_Stream' (it may contain other fields
** after that initial structure).
*/

const FILEHANDLE = "FILE*";

struct LuaLStream {
	void* f;  // stream (NULL for incompletely created streams)
	LuaCFunction closef;  // to close stream (NULL for closed streams)
}

