module lua;

struct L_Reg {
  ZString name;
  CFunction func;
}

const NUMSIZES	= Integer.sizeof*16 + Number.sizeof;

extern fn void State.checkversion(&l, Number ver = VERSION_NUM, isz sz = NUMSIZES) @cname("luaL_checkversion_");

extern fn int		State.l_getmetafield(&l, int arg, ZString e) 			@cname("luaL_getmetafield");
extern fn int 		State.l_callmeta(&l, int arg, ZString e) 				@cname("luaL_callmeta");
extern fn ZString 	State.l_tolstring(&l, int idx, isz* e) 					@cname("luaL_tolstring");
extern fn int 		State.l_argerror(&l, int arg, ZString e) 				@cname("luaL_argerror");
extern fn int 		State.l_typeerror(&l, int arg, ZString tname) 			@cname("luaL_typeerror");
extern fn ZString 	State.l_checklstring(&l, int arg, isz* e) 				@cname("luaL_checklstring");
extern fn ZString 	State.l_optlstring(&l, int arg, ZString def, isz* len) 	@cname("luaL_optlstring");
extern fn Number 	State.l_checknumber(&l, int arg) 						@cname("luaL_checknumber");
extern fn Number 	State.l_optnumber(&l, int arg, Number def) 				@cname("luaL_optnumber");

extern fn Integer State.l_checkinteger(&l, int arg, ZString e)	@cname("luaL_checkinteger");
extern fn Integer State.l_optinteger(&l, int arg, ZString e) 	@cname("luaL_optinteger");

extern fn void 	State.l_checkstack(&l, int sz, ZString msg) 	@cname("luaL_checkstack");
extern fn void 	State.l_checktype(&l, int arg, int t) 			@cname("luaL_checktype");
extern fn void 	State.l_checkany(&l, int arg) 					@cname("luaL_checkany");

extern fn int 	State.l_newmetatable(&l, ZString tname) 		@cname("luaL_newmetatable");
extern fn void 	State.l_setmetatable(&l, ZString tname) 		@cname("luaL_setmetatable");
extern fn void* State.l_testudata(&l, int ud, ZString tname) 	@cname("luaL_testudata");
extern fn void* State.l_checkudata(&l, int ud, ZString tname) 	@cname("luaL_checkudata");

extern fn void 	State.l_where(&l, int lvl) 		@cname("luaL_where");
extern fn int 	State.l_error(&l, ZString fmt) 	@cname("luaL_error");

extern fn int 	State.l_checkoption(&l, int arg, ZString def, ZString* lst) @cname("luaL_checkoption");

extern fn int 	State.l_fileresult(&l, int stat, ZString fname) 	@cname("luaL_fileresult");
extern fn int 	State.l_execresult(&l, int stat)					@cname("luaL_execresult");

/* predefined references */
const NOREF = 	-1;
const REFNIL = 	-2;

extern fn int 	State.l_ref(&l, int t) 				@cname("luaL_ref");
extern fn int 	State.l_unref(&l, int t, int ref) 	@cname("luaL_unref");

extern fn int 	State.l_loadfilex(&l, ZString filename, ZString mode) @cname("luaL_loadfilex");
macro int 		State.l_loadfile(&l, ZString f) { return l.l_loadfilex(f, null); }


extern fn int State.l_loadstring(&l, ZString s) @cname("luaL_loadstring");
extern fn int State.l_loadbufferx(&l, ZString buff, usz sz, ZString name, ZString mode) @cname("luaL_loadbufferx");

extern fn State* l_newstate() @cname("luaL_newstate");

extern fn Integer State.l_len(&l, int idx) @cname("luaL_len");

extern fn void State.l_addgsub(&l, L_Buffer* b, ZString s, ZString p, ZString r) @cname("luaL_addgsub");
extern fn ZString State.l_gsub(&l, ZString s, ZString p, ZString r) @cname("luaL_gsub");

extern fn void State.l_setfuncs(&l, L_Reg* funcs, int nup) @cname("luaL_setfuncs");

extern fn int State.l_getsubtable(&l, int idx, ZString fname) @cname("luaL_getsubtable");

extern fn void State.l_traceback(&l, State*  l1, ZString msg, int level) @cname("luaL_traceback");

extern fn void State.l_requiref(&l, ZString modname, CFunction openf, int glb) @cname("luaL_requiref");


/*
** ===============================================================
** some useful macros
** ===============================================================
*/

macro void State.@l_newlibtable(&l, #table) { l.createtable(0, #table.sizeof/table.[0].sizeof - 1); }
macro void State.l_newlib(&l, L_Reg* lib) { l.checkversion(); l.l_newlibtable(lib); l.l_setfuncs(lib, o);}
macro void State.@l_argcheck(&l, #cond, int arg, ZString extramsg) { #cond || l.l_argerror(arg, extramsg); }
macro void State.@l_argexpected(&l, #cond, int arg, ZString tname) { #cond || l.l_typeerror(arg, tname); }
macro void State.l_checkstring(&l, n) { return l.l_checklstring(n, null); }
macro void State.l_optstring(&l, n, d) { return l.l_optlstring(n, d, null); }

macro State.l_typename(&l, i) { return l.typename(l.type(i)); }
macro State.l_dofile(&l, func) { return l.l_loadfile(L, func) || l.pcall(0, MULTRET, 0); }
macro int State.l_dostring(&l, s) { return (int)(l.l_loadstring(s) || l.pcall(0, MULTRET, 0)); }
macro State.l_getmetatable(&l, n) { return l.getfield(REGISTRYINDEX, n); }

macro State.l_opt(&l,f,n,d) { return l.isnoneornil(L,n) ? d : f(L,n);}
macro int State.l_loadbuffer(&l, ZString s, usz sz, ZString name) { return l_loadbufferx(l, s, sz, name, null); }
macro State.l_pushfail(&l) { return l.pushnil();}

/*
** {======================================================
** Generic Buffer manipulation
** =======================================================
*/

struct L_Buffer {
	char* b;
	usz size;
	usz n;
	State*  lua;
	union {
		usz[16] init; // ensure maximum alignment for buffer
		char[BUFFERSIZE] b_init;  // initial buffer
	}
}

macro usz L_Buffer.l_bufflen(&bf) { return bf.n; }
macro char* L_Buffer.l_buffaddr(&bf) { return bf.b; }

macro void L_Buffer.l_addchar(&b, char c) { 
 	if (b.n >= b.size) l_prepbuffsize(b, 1); 
 	b.b[b.n++] = c; 
}

macro void L_Buffer.l_addsize(&b, usz s) { b.n += s; }

macro void L_Buffer.l_buffsub(&b, usz s) { b.n -= s; }

extern fn void State.l_buffinit(&l, L_Buffer* b) @cname("luaL_buffinit");
extern fn char* L_Buffer.l_prepbuffsize(&b, usz sz) @cname("luaL_prepbuffsize");
extern fn void L_Buffer.l_addlstring(&b, ZString s, usz l) @cname("luaL_addlstring");
extern fn void L_Buffer.l_addstring(&b, ZString s) @cname("luaL_addstring");
extern fn void L_Buffer.l_addvalue(&b) @cname("luaL_addvalue");
extern fn void L_Buffer.l_pushresult(&b) @cname("luaL_pushresult");
extern fn void L_Buffer.l_pushresultsize(&b, usz sz) @cname("luaL_pushresultsize");
extern fn char* State.l_buffinitsize(&l, L_Buffer* b, usz sz) @cname("luaL_buffinitsize");

macro char* L_Buffer.l_prepbuffer(&b) { return b.l_prepbuffsize(BUFFERSIZE); }

/* }====================================================== */

/*
** {======================================================
** File handles for IO library
** =======================================================
*/

/*
** A file handle is a userdata with metatable 'LUA_FILEHANDLE' and
** initial structure 'luaL_Stream' (it may contain other fields
** after that initial structure).
*/

const FILEHANDLE = "FILE*";

struct L_Stream {
	void* f;  // stream (NULL for incompletely created streams)
	CFunction closef;  // to close stream (NULL for closed streams)
}

