module lua54::lua;

const VERSION_MAJOR	= 	"5";
const VERSION_MINOR	= 	"4";
const VERSION_RELEASE = "2";

const VERSION_NUM = 504;
const VERSION_RELEASE_NUM = VERSION_NUM * 100 + 0;

const MULTRET = -1;

const REGISTRYINDEX = -MAXSTACK - 1000;

/* thread status */
const OK = 			0;
const YIELD	= 		1;
const ERRRUN = 		2;
const ERRSYNTAX	= 	3;
const ERRMEM = 		4;
const ERRERR = 		5;
const ERRFILE = 	6;

typedef LuaState = void*;

/*
** basic types
*/
const TNONE	= 			-1;
const TNIL = 			0;
const TBOOLEAN = 		1;
const TLIGHTUSERDATA = 	2;
const TNUMBER = 		3;
const TSTRING = 		4;
const TTABLE = 			5;
const TFUNCTION = 		6;
const TUSERDATA	= 		7;
const TTHREAD =			8;

const NUMTYPES = 		9;

/* minimum Lua stack available to a C function */
const MINSTACK = 20;


/* predefined values in the registry */
const RIDX_MAINTHREAD = 1;
const RIDX_GLOBALS = 	2;
const RIDX_LAST = 		RIDX_GLOBALS;

/* type of numbers in Lua */
alias LuaNumber @if(uptr.sizeof == 4) = float;
alias LuaNumber @if(uptr.sizeof == 8) = double;

/* type for integer functions */
alias LuaInteger @if(uptr.sizeof == 4) = int;
alias LuaInteger @if(uptr.sizeof == 8) = long;

/* unsigned integer type */
alias LuaUnsigned @if(uptr.sizeof == 4) = uint;
alias LuaUnsigned @if(uptr.sizeof == 8) = ulong;

/* type for continuation-function contexts */
alias LuaKContext = isz;

/*
** Type for C functions registered with Lua
*/
alias LuaCFunction = fn int (LuaState* l);

/*
** Type for continuation functions
*/
alias LuaKFunction = fn int (LuaState* l, int status, LuaKContext ctx);

/*
** Type for functions that read/write blocks when loading/dumping Lua chunks
*/
alias LuaReader = fn ZString (LuaState* l, void* ud, usz sz);
alias LuaWriter = fn int (LuaState* l, void* p, usz sz, void* ud);

/*
** Type for memory-allocation functions
*/
alias LuaAlloc = fn void* (void* ud, void* ptr, usz osize, usz nsize);

/*
** Type for warning functions
*/
alias LuaWarnFunction = fn void* (void *ud, ZString msg, int tocont);

/*
** RCS ident string
*/
/*
extern const char lua_ident[];
*/


/*
** state manipulation
*/
extern fn LuaState* 	newstate(LuaAlloc lua_alloc, void* ud) 	@cname("lua_newstate");
extern fn void 			close(LuaState* l) 						@cname("lua_close");
extern fn LuaState* 	newthread(LuaState* l) 					@cname("lua_newthread");
extern fn int 			resetthread(LuaState* l) 				@cname("lua_resetthread");

extern fn LuaCFunction 	atpanic(LuaState* l, LuaCFunction panicf) 	@cname("lua_atpanic");
extern fn LuaNumber 	version(LuaState* l) 						@cname("lua_version");

/*
** basic stack manipulation
*/
extern fn int 	absindex	(LuaState* l, int idx) 					@cname("lua_absindex");
extern fn int 	gettop		(LuaState* l) 							@cname("lua_gettop");
extern fn void 	settop		(LuaState* l, int idx) 					@cname("lua_settop");
extern fn void 	pushvalue	(LuaState* l, int idx) 					@cname("lua_pushvalue");
extern fn void 	rotate		(LuaState* l, int idx, int n) 			@cname("lua_rotate");
extern fn void 	copy		(LuaState* l, int fromidx, int toidx) 	@cname("lua_copy");
extern fn int 	checkstack	(LuaState* l, int n) 					@cname("lua_checkstack");

extern fn void 	xmove		(LuaState* l, LuaState *to, int n) 		@cname("lua_xmove");

/*
** access functions (stack -> C)
*/
extern fn int 		isnumber		(LuaState* l, int idx) @cname("lua_isnumber");
extern fn int 		isstring		(LuaState* l, int idx) @cname("lua_isstring");
extern fn int 		iscfunction		(LuaState* l, int idx) @cname("lua_iscfunction");
extern fn int 		isinteger		(LuaState* l, int idx) @cname("lua_isinteger");
extern fn int 		isuserdata		(LuaState* l, int idx) @cname("lua_isuserdata");
extern fn int 		type			(LuaState* l, int idx) @cname("lua_type");
extern fn ZString 	typename		(LuaState* l, int idx) @cname("lua_typename");

extern fn LuaNumber 	tonumberx		(LuaState* l, int idx, int* isnum) 	@cname("lua_tonumberx");
extern fn LuaInteger 	tointegerx		(LuaState* l, int idx, int* isnum) 	@cname("lua_tointegerx");
extern fn int 			toboolean		(LuaState* l, int idx) 				@cname("lua_toboolean");
extern fn ZString 		tolstring		(LuaState* l, int idx, usz* len) 	@cname("lua_tolstring");
extern fn LuaUnsigned 	rawlen			(LuaState* l, int idx) 				@cname("lua_rawlen");
extern fn LuaCFunction 	tocfunction		(LuaState* l, int idx) 				@cname("lua_tocfunction");
extern fn void* 		touserdata		(LuaState* l, int idx) 				@cname("lua_touserdata");
extern fn LuaState* 	tothread		(LuaState* l, int idx) 				@cname("lua_tothread");
extern fn void* 		topointer		(LuaState* l, int idx) 				@cname("lua_topointer");

/*
** Comparison and arithmetic functions
*/
const OPADD = 	0;	/* ORDER TM, ORDER OP */
const OPSUB = 	1;
const OPMUL	= 	2;
const OPMOD	=	3;
const OPPOW	= 	4;
const OPDIV	= 	5;
const OPIDIV = 	6;
const OPBAND = 	7;
const OPBOR = 	8;
const OPBXOR = 	9;
const OPSHL = 	10;
const OPSHR = 	11;
const OPUNM = 	12;
const OPBNOT = 	13;

extern fn void arith(LuaState* l, int op) @cname("lua_arith");

const OPEQ = 0;
const OPLT = 1;
const OPLE = 2;

extern fn void rawequal		(LuaState* l, int idx1, int idx2) 			@cname("lua_rawequal");
extern fn void lua_compare	(LuaState* l, int idx1, int idx2, int op) 	@cname("lua_compare");

/*
** push functions (C -> stack)
*/
extern fn void pushnil				(LuaState* l) 							@cname("lua_pushnil");
extern fn void pushnumber			(LuaState* l, LuaNumber z) 				@cname("lua_pushnumber");
extern fn void pushinteger			(LuaState* l, LuaInteger n) 			@cname("lua_pushinteger");
extern fn ZString pushlstring		(LuaState* l, ZString s, usz len) 		@cname("lua_pushlstring");
extern fn ZString pushstring		(LuaState* l, ZString s) 				@cname("lua_pushstring");
extern fn ZString pushvfstring		(LuaState* l, ZString fmt, char* argp) 	@cname("lua_pushvfstring");
extern fn ZString pushfstring		(LuaState* l, ZString fmt, ...) 		@cname("lua_pushfstring");
extern fn void pushcclosure			(LuaState* l, LuaCFunction func, int n) @cname("lua_pushcclosure");
extern fn void pushboolean			(LuaState* l, int b)					@cname("lua_pushboolean");
extern fn void pushlightuserdata	(LuaState* l, void* p)				 	@cname("lua_pushlightuserdata");
extern fn int pushthread			(LuaState* l) 							@cname("lua_pushthread");

/*
** get functions (Lua -> stack)
*/
extern fn int getglobal		(LuaState* l, ZString name) 			@cname("lua_getglobal");
extern fn int gettable		(LuaState* l, int idx) 					@cname("lua_gettable");
extern fn int getfield		(LuaState* l, int idx, ZString k) 		@cname("lua_getfield");
extern fn int geti			(LuaState* l, int idx, LuaInteger n) 	@cname("lua_geti");
extern fn int rawget		(LuaState* l, int idx) 					@cname("lua_rawget");
extern fn int rawgeti		(LuaState* l, int idx, LuaInteger n) 	@cname("lua_rawgeti");
extern fn int rawgetp		(LuaState* l, int idx, void* p) 		@cname("lua_rawgetp");

extern fn void 	createtable		(LuaState* l, int narr, int nrec) 	@cname("lua_createtable");
extern fn void* newuserdatauv	(LuaState* l, usz sz, int nuvalue) 	@cname("lua_newuserdatauv");
extern fn int 	getmetatable	(LuaState* l, int objindex) 		@cname("lua_getmetatable");
extern fn int 	getiuservalue	(LuaState* l, int idx, int n) 		@cname("lua_getiuservalue");

/*
** set functions (stack -> Lua)
*/
extern fn void 	setglobal		(LuaState* l, ZString name) 			@cname("lua_setglobal");
extern fn void 	settable		(LuaState* l, int idx) 					@cname("lua_settable");
extern fn void 	setfield		(LuaState* l, int idx, ZString k) 		@cname("lua_setfield");
extern fn void 	seti			(LuaState* l, int idx, LuaInteger n) 	@cname("lua_seti");
extern fn void 	rawset			(LuaState* l, int idx) 					@cname("lua_rawset");
extern fn void 	rawseti			(LuaState* l, int idx, LuaInteger n) 	@cname("lua_rawseti");
extern fn void 	rawsetp			(LuaState* l, int idx, void* p) 		@cname("lua_rawsetp");
extern fn int 	setmetatable	(LuaState* l, int objindex) 			@cname("lua_setmetatable");
extern fn int 	setiuservalue	(LuaState* l, int idx, int n) 			@cname("lua_setiuservalue");

/*
** 'load' and 'call' functions (load and run Lua code)
*/
extern fn int callk(LuaState *l, int nargs, int nresults, LuaKContext ctx, LuaKFunction k) @cname("lua_callk");
macro int call(LuaState* l, n, r) { return lua::callk(l, n, r, 0, null); }

extern fn int pcallk(LuaState *l, int nargs, int nresults, int errfunc, LuaKContext ctx, LuaKFunction k) @cname("lua_pcallk");
macro int pcall(LuaState *l, int n, int r, int f) { return lua::pcallk(l, n, r, f, 0, null); }

extern fn int load(LuaState* l, LuaReader reader, void* ud, ZString chunkname, ZString mode) 	@cname("lua_load");
extern fn int dump(LuaState* l, LuaWriter writer, void* data, int strip) 						@cname("lua_dump");

/*
** coroutine functions
*/
extern fn int yieldk(LuaState* l, int nresults, LuaKContext ctx, LuaKFunction k) 	@cname("lua_yieldk");
extern fn int resume(LuaState* l, LuaState* from, int narg, int* nres) 				@cname("lua_resume");
extern fn int status(LuaState* l) 		@cname("lua_status");
extern fn int isyieldable(LuaState* l)	@cname("lua_isyieldable");

macro int yield(LuaState* l, int n) { return lua::yieldk(l, n, 0, null); }


/*
** Warning-related functions
*/
extern fn void setwarnf	(LuaState* l, LuaWarnFunction f, void* ud) 	@cname("lua_setwarnf");
extern fn void warning	(LuaState* l, ZString msg, int tocont) 		@cname("lua_warning");

/*
** garbage-collection function and options
*/
const GCSTOP = 0;
const GCRESTART = 1;
const GCCOLLECT = 2;
const GCCOUNT = 3;
const GCCOUNTB = 4;
const GCSTEP = 5;
const GCSETPAUSE = 6;
const GCSETSTEPMUL = 7;
const GCISRUNNING = 9;
const GCGEN = 10;
const GCINC = 11;

extern fn int gc(LuaState* l, int what, ...) @cname("lua_gc");


/*
** miscellaneous functions
*/
extern fn void 	len				(LuaState* l, int idx) 	@cname("lua_len");
extern fn int 	next			(LuaState* l, int idx) 	@cname("lua_next");
extern fn int 	error			(LuaState* l) 			@cname("lua_error");
extern fn void 	concat			(LuaState* l, int n) 	@cname("lua_concat");
extern fn void 	toclose			(LuaState* l, int idx) 	@cname("lua_toclose");
extern fn void 	setallocf		(LuaState* l, LuaAlloc f, void* ud) 	@cname("lua_setallocf");
extern fn LuaAlloc getallocf	(LuaState* l, void** ud) @cname("lua_getallocf");
extern fn usz 	stringtonumber	(LuaState* l, ZString s) @cname("lua_stringtonumber");

/*
** {==============================================================
** some useful macros
** ===============================================================
*/

macro void* getextraspace(LuaState* l) { return (void*)((char*)(l) - 0); }

macro LuaNumber tonumber	(LuaState* l, int idx) { return lua::tonumberx(l, idx, null); }
macro LuaInteger tointeger	(LuaState* l, int idx) { return lua::tointegerx(l, idx, null); }

macro void pop(LuaState* l, int n) { lua::settop(l, -(n)-1); }

macro void newtable(LuaState* l) { lua::createtable(l, 0, 0); }

macro void register(LuaState* l, ZString name, LuaCFunction func) { lua::pushcclosure(l, func, 0); lua::setglobal(l, name); }

macro void pushcfunction(LuaState* l, LuaCFunction func) { lua::pushcclosure(l, func, 0); }

macro bool isfunction 		(LuaState* l, int n) { return lua::type(l, n) == TFUNCTION; }
macro bool istable			(LuaState* l, int n) { return lua::type(l, n) == TTABLE; }
macro bool islightuserdata	(LuaState* l, int n) { return lua::type(l, n) == TLIGHTUSERDATA; }
macro bool isnil   		    (LuaState* l, int n) { return lua::type(l, n) == TNIL; }
macro bool isboolean		(LuaState* l, int n) { return lua::type(l, n) == TBOOLEAN; }
macro bool isthread		    (LuaState* l, int n) { return lua::type(l, n) == TTHREAD; }
macro bool isnone			(LuaState* l, int n) { return lua::type(l, n) == TNONE; }
macro bool isnoneornil		(LuaState* l, int n) { return lua::type(l, n) <= 0; }

macro void pushliteral(LuaState* l, ZString s) { lua::pushstring(l, s); }

macro void pushglobaltable(LuaState* l) { lua::rawgeti(l, REGISTRYINDEX, RIDX_GLOBALS); }

macro ZString tostring(LuaState* l, int idx) { return lua::tolstring(l, idx, null); }

macro void insert(LuaState* l, int idx) { lua::rotate(l, idx, 1); }

macro void remove(LuaState* l, int idx) { lua::rotate(l, idx, -1); lua::pop(l, 1); }

macro void replace(LuaState* l, int idx) { lua::copy(l, -1, idx); lua::pop(l, 1); }


/* ============================================================== */

/*
** ======================================================================
** LuaDebug API
** =======================================================================
*/

/*
** Event codes
*/
const HOOKCALL = 		0;
const HOOKRET = 		1;
const HOOKLINE = 		2;
const HOOKCOUNT = 		3;
const HOOKTAILCALL = 	4;

/*
** Event masks
*/
const MASKCALL = 	(1 << HOOKCALL);
const MASKRET = 	(1 << HOOKRET);
const MASKLINE = 	(1 << HOOKLINE);
const MASKCOUNT = 	(1 << HOOKCOUNT);

alias LuaDebug = void*;  /* activation record */

/* Functions to be called by the debugger in specific events */
alias LuaHook = fn void(LuaState* l, LuaDebug* ar);

extern fn int 		getstack	(LuaState* l, int level, LuaDebug *ar) 		@cname("lua_getstack");
extern fn int 		getinfo		(LuaState* l, ZString what, LuaDebug *ar) 	@cname("lua_getinfo");
extern fn ZString 	getlocal	(LuaState* l, LuaDebug *ar, int n) 			@cname("lua_getlocal");
extern fn ZString 	setlocal	(LuaState* l, LuaDebug *ar, int n) 			@cname("lua_setlocal");
extern fn ZString 	getupvalue	(LuaState* l, int funcindex, int n) 		@cname("lua_getupvalue");
extern fn ZString 	setupvalue	(LuaState* l, int funcindex, int n) 		@cname("lua_setupvalue");

extern fn void* 	upvalueid	(LuaState* l, int fidx, int n) 		@cname("lua_upvalueid");
extern fn void 		upvaluejoin	(LuaState* l, int fidx1, int n1,
                                            	int fidx2, int n2) 	@cname("lua_upvaluejoin");

extern fn void 		sethook		(LuaState* l, LuaHook func, int mask, int count) @cname("lua_sethook");
extern fn LuaHook 	gethook		(LuaState* l) 	@cname("lua_gethook");
extern fn int 		gethookmask	(LuaState* l) 	@cname("lua_gethookmask");
extern fn int 		gethookcount(LuaState* l) 	@cname("lua_gethookcount");

extern fn int 		setcstacklimit(LuaState* l, uint limit) @cname("lua_setcstacklimit");


